{
  "name": "dragon-keeper",
  "private": true,
  "version": "0.1.0",
  "description": "Dragon Keeper: a cozy creature-care browser game for ages 8-11 (prototype)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
